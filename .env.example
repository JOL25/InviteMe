NEXT_PUBLIC_SITE_URL=http://localhost:3101
# Solo servidor. db:start configura automáticamente una instancia local aislada.
DATABASE_URL=postgresql://inviteme_runtime:TU_PASSWORD@127.0.0.1:55432/inviteme
# Secreto aleatorio de al menos 32 caracteres para anonimizar el rate limiting.
RSVP_RATE_LIMIT_SECRET=
# Secreto estable para reconstruir enlaces individuales; db:start lo genera.
INVITATION_LINK_SECRET=
# Desarrollo local: enlaces de recuperación en .local/mail, sin envío externo.
PASSWORD_RESET_DELIVERY=local
# Para correo real: cambiar a smtp y configurar un remitente autorizado.
# smtp-test es exclusivo de las pruebas automáticas en loopback.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Opcional: al configurar ambas claves, el RSVP exige Cloudflare Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Las migraciones usan DATABASE_MIGRATION_URL desde .env.database (no cargar en Next.js).
