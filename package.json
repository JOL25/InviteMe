{
  "name": "inviteme",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "node scripts/postgres-local.mjs start",
    "db:stop": "node scripts/postgres-local.mjs stop",
    "db:status": "node scripts/postgres-local.mjs status",
    "db:migrate": "node --env-file=.env.local --env-file=.env.database scripts/migrate.mjs",
    "mail:local": "node --env-file=.env.local scripts/mail-local.mjs",
    "test:local": "node scripts/test-local.mjs",
    "test:smtp": "node scripts/test-local.mjs --smtp"
  },
  "dependencies": {
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mailparser": "3.9.0",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/smtp-server": "3.5.13",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "mailparser": "3.14.1",
    "prettier": "3.9.10",
    "smtp-server": "3.21.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "type": "module"
}
